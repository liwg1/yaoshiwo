# ===== 依赖与构建产物 =====
node_modules/
out/
dist/
release/
*.log

# ===== 本机缓存（有人按 README 里的镜像配置会在项目里生成这些目录）=====
.npm-cache/
.electron-cache/
.electron-builder-cache/
.tools/
.tmp-*/

# ===== 绝不入库：用户自己的密码库与备份 =====
# 密码库文件是你的命根子，任何情况下都不要提交到仓库
.backup/
*.kdbx
*.kdbx.bak-*
*.diag-xml.xml
.tmp-*.xml

# ===== 本地私密配置 / 令牌 =====
# 浏览器扩展令牌（运行时生成在 %APPDATA%\safevault\extension.json，别复制进项目）
extension.json
.env
.env.local
.deploy-secrets.json

# ===== 官网的本地预览与安装包（安装包 80MB，走 GitHub Releases 或服务器，不进仓库）=====
website/preview/
website/download/*.exe
website/download/*.zip
# 官网下载区那份「已解压的扩展」是 make-extension-zip.mjs 生成出来的副本，源在 chrome-extension/
website/download/YaoShiWo-chrome-extension/

# ===== 编辑器 / 系统垃圾 =====
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# 根目录下的 zip 是打包浏览器扩展用的临时产物
chrome-extension.zip

# ===== 自检脚本用的临时 Electron 数据目录 =====
.site-check-userdata/
.cover-userdata/

# 图片渲染用的 Electron 用户数据
.render-userdata/
